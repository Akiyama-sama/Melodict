{
  "app-id": "io.github.Akiyama-sama.knote",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "24.08",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.node22"],
  "command": "run.sh",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--filesystem=xdg-music"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/node22/bin",
    "env": {
      "NPM_CONFIG_LOGLEVEL": "info"
    }
  },
  "modules": [
    {
      "name": "Knote",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "XDG_CACHE_HOME": "/run/build/Knote/flatpak-node/cache",
          "npm_config_cache": "/run/build/Knote/flatpak-node/npm-cache",
          "npm_config_offline": "true"
        }
      },
      "build-commands": [
        "npm install --offline",
        "npm run build:flatpak",
        "cp -a dist/linux*unpacked /app/main",
        "install -Dm755 -t /app/bin/ ../run.sh",
        "install -Dm644 resources/logo_light_mode.png /app/share/icons/hicolor/scalable/apps/io.github.Akiyama-sama.knote.png",
        "install -Dm644 flatpak/io.github.Akiyama-sama.knote.desktop /app/share/applications/io.github.Akiyama-sama.knote.desktop",
        "install -Dm644 flatpak/io.github.Akiyama-sama.knote.metainfo.xml /app/share/metainfo/io.github.Akiyama-sama.knote.appdata.xml"
      ],
      "subdir": "main",
      "sources": [
        {
          "type": "file",
          "path": "../package.json"
        },
        {
          "type": "dir",
          "path": "..",
          "dest": "main"
        },
        "generated-sources.json",
        {
          "type": "script",
          "dest-filename": "run.sh",
          "commands": ["cd /", "zypak-wrapper.sh /app/main/Knote --ozone-platform-hint=auto \"$@\""]
        }
      ]
    }
  ]
}
